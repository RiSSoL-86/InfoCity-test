# Application
PROJECT_NAME="InfoCity Semantic Search"
DEBUG=true

# Corporate proxy (leave empty for a direct connection)
HTTP_PROXY=
HTTPS_PROXY=

# PostgreSQL with pgvector
POSTGRES_DB=infocity
POSTGRES_USER=infocity
POSTGRES_PASSWORD=infocity
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Celery and Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Prepared question-answer dataset
SOURCE_FILE_PATH=data/questions.csv

# Local embedding model
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
